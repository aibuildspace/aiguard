# AIGate Configuration
# Copy this file to .env and fill in your values.

# ── Server ──────────────────────────────────────────────────────────────────
GUARD_HOST=127.0.0.1
GUARD_PORT=8080
GUARD_LOG_LEVEL=info
GUARD_DEBUG=false

# ── Database ─────────────────────────────────────────────────────────────────
# Default: SQLite (zero config). For production, use Postgres:
# GUARD_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/aigate
GUARD_DATABASE_URL=sqlite+aiosqlite:///./aigate.db

# ── Encryption (required for key-vault mode) ─────────────────────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GUARD_ENCRYPTION_KEY=

# ── Shields ──────────────────────────────────────────────────────────────────
# Colon-separated list of directories to load shields from (like PATH)
GUARD_SHIELDS_DIRS=./shields:./user_shields

# ── Upstream APIs ────────────────────────────────────────────────────────────
GUARD_ANTHROPIC_BASE_URL=https://api.anthropic.com
GUARD_OPENAI_BASE_URL=https://api.openai.com

# ── Proxy Mode ───────────────────────────────────────────────────────────────
# true  = passthrough: client's real API key is forwarded as-is (simplest setup)
# false = key-vault: clients use aigate keys; real keys stored encrypted in DB
GUARD_PASSTHROUGH_MODE=true

# ── Admin API ────────────────────────────────────────────────────────────────
GUARD_ADMIN_API_ENABLED=true
# Required if admin API is enabled. Used for management endpoints and CLI.
GUARD_ADMIN_API_KEY=


# ── HTTP Client ──────────────────────────────────────────────────────────────
GUARD_UPSTREAM_CONNECT_TIMEOUT=10.0
GUARD_UPSTREAM_READ_TIMEOUT=120.0
